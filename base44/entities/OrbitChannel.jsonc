{
  "name": "OrbitChannel",
  "type": "object",
  "properties": {
    "server_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "topic": {
      "type": "string"
    },
    "slow_mode_seconds": {
      "type": "number"
    },
    "position": {
      "type": "number"
    }
  },
  "required": [
    "server_id",
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "user"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}