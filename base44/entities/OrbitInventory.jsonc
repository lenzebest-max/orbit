{
  "name": "OrbitInventory",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "item_id": {
      "type": "string"
    },
    "equipped": {
      "type": "boolean"
    },
    "gifted_by": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "item_id"
  ],
  "rls": {
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}