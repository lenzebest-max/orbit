{
  "name": "OrbitMessage",
  "type": "object",
  "properties": {
    "server_id": {
      "type": "string"
    },
    "channel_id": {
      "type": "string"
    },
    "author_id": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reactions": {
      "type": "object"
    },
    "reply_to": {
      "type": "string"
    },
    "reported": {
      "type": "boolean"
    },
    "deleted": {
      "type": "boolean"
    }
  },
  "required": [
    "channel_id",
    "author_id",
    "text"
  ],
  "rls": {
    "create": {
      "data.author_id": "{{user.id}}"
    },
    "read": {
      "user_condition": {
        "role": "user"
      }
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}