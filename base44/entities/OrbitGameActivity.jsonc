{
  "name": "OrbitGameActivity",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "game_id": {
      "type": "string"
    },
    "game_title": {
      "type": "string"
    },
    "favorite": {
      "type": "boolean"
    },
    "last_played": {
      "type": "string"
    },
    "play_count": {
      "type": "number"
    }
  },
  "required": [
    "user_id",
    "game_id"
  ],
  "rls": {
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}